cmake_minimum_required(VERSION 3.24)

# Check translation units by source filename, not by NVCC command layout.
# In particular, NVCC's -o output argument may follow its -c argument.
if(NOT EXISTS "${COMPILE_DATABASE}")
    message(FATAL_ERROR "CUDA compile database missing: ${COMPILE_DATABASE}")
endif()
file(READ "${COMPILE_DATABASE}" commands)
string(JSON count LENGTH "${commands}")
set(cuda_count 0)
set(cxx_count 0)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON source GET "${commands}" ${i} file)
        if(source MATCHES "\\.cu$")
            math(EXPR cuda_count "${cuda_count} + 1")
        elseif(source MATCHES "\\.(cpp|cc|cxx|C)$")
            math(EXPR cxx_count "${cxx_count} + 1")
        else()
            continue()
        endif()
        string(JSON command GET "${commands}" ${i} command)
        separate_arguments(args UNIX_COMMAND "${command}")
        if(NOT "-DCCCL_DISABLE_NVTX" IN_LIST args)
            message(FATAL_ERROR "CCCL_DISABLE_NVTX missing from compile command for ${source}")
        endif()
    endforeach()
endif()
if(cuda_count EQUAL 0 OR cxx_count EQUAL 0)
    message(FATAL_ERROR "Expected CUDA and host C++ entries, found CUDA=${cuda_count}, C++=${cxx_count}")
endif()
message(STATUS "CCCL_DISABLE_NVTX verified on ${cuda_count} CUDA and ${cxx_count} host C++ translation units")
