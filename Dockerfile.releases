FROM golang:1.24.4 AS build
# Compatibility only: source-controlled releases/current is authoritative.
ARG RELEASE_VERSION
WORKDIR /src
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY scripts/ ./scripts/
COPY releases/ ./releases/
COPY install.sh ./
RUN RELEASE_VERSION="$RELEASE_VERSION" sh scripts/build-release-site.sh

FROM nginx:1.28-alpine
COPY --from=build /src/dist/site/ /usr/share/nginx/html/
EXPOSE 80
